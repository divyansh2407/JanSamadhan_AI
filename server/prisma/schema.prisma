// ──────────────────────────────────────────────
// JanSamadhan – Prisma Schema
// PostgreSQL Relational Database Architecture
// ──────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  CITIZEN
  GOVERNMENT
  UNIVERSITY
  EXPERT
  INDUSTRY
  SUPER_ADMIN
}

enum ProblemSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProblemPriority {
  LOW
  MEDIUM
  NORMAL
  HIGH
  URGENT
}

enum ProblemStatus {
  SUBMITTED
  UNDER_REVIEW
  ACKNOWLEDGED
  VERIFIED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum GovernmentRole {
  GOVERNMENT_ADMIN
  DEPARTMENT_HEAD
  GOVERNMENT_OFFICER
  FIELD_INSPECTOR
}

enum VerificationAction {
  VERIFY
  REJECT
  REQUEST_INFO
}

enum OfficerAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  PROPOSED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

enum CollaborationStatus {
  INITIATED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum VerificationStatus {
  CONFIRMED_RESOLVED
  DISPUTED_REOPENED
  AUTO_CLOSED_TIMEOUT
}

// ── Models ───────────────────────────────────────────────────────────────────

/// Multi-City / Municipal Corporation Entity (e.g. Pune, Bengaluru, Mumbai)
model City {
  id              String   @id @default(uuid())
  name            String   @unique
  state           String
  corporationCode String   @unique
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  wards       Ward[]                     @relation("CityWards")
  departments Department[]               @relation("CityDepartments")
  problems    Problem[]                  @relation("CityProblems")
  officers    GovernmentOfficerProfile[] @relation("CityOfficers")

  @@index([name])
  @@index([corporationCode])
  @@map("cities")
}

/// Ward / Territorial division within a city
model Ward {
  id              String   @id @default(uuid())
  cityId          String
  wardNumber      Int
  name            String
  boundaryGeoJson Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  city     City      @relation("CityWards", fields: [cityId], references: [id], onDelete: Cascade)
  problems Problem[] @relation("WardProblems")

  @@unique([cityId, wardNumber])
  @@index([cityId])
  @@index([name])
  @@map("wards")
}

/// Universities, NGOs, Contractors, and Industry partners
model Organization {
  id                 String   @id @default(uuid())
  name               String
  orgType            String // ACADEMIC, INDUSTRY, EXPERT_CONSORTIUM, NGO
  registrationNumber String? // CIN, UGC, Registration ID
  contactEmail       String?
  contactPhone       String?
  isVerified         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relationships
  solutionProposals SolutionProposal[]    @relation("OrganizationProposals")
  collaborations    CollaborationMember[] @relation("OrgCollaborationMembers")

  @@index([name])
  @@index([orgType])
  @@map("organizations")
}

/// Municipal and administrative government departments
model Department {
  id             String   @id @default(uuid())
  cityId         String?
  name           String
  description    String?
  departmentCode String   @unique
  city           String
  state          String
  contactEmail   String
  contactPhone   String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  cityEntity          City?                      @relation("CityDepartments", fields: [cityId], references: [id], onDelete: SetNull)
  assignedProblems    Problem[]                  @relation("DepartmentProblems")
  implementationTasks ImplementationTask[]       @relation("DepartmentTasks")
  officers            GovernmentOfficerProfile[] @relation("DepartmentOfficers")
  assignedRecords     DepartmentAssignment[]     @relation("DepartmentAssignedRecords")

  @@index([city])
  @@index([departmentCode])
  @@map("departments")
}

/// User accounts across all 6 civic stakeholder roles
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         UserRole @default(CITIZEN)
  isActive     Boolean  @default(true)
  isVerified   Boolean  @default(false)
  city             String?
  organizationName String?
  departmentName   String?
  designation      String?
  areaOfExpertise  String?
  industryType     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  reportedProblems        Problem[]                @relation("ReportedByUser")
  solutionProposals       SolutionProposal[]       @relation("SubmittedProposals")
  assignedTasks           ImplementationTask[]     @relation("AssignedToUser")
  notifications           Notification[]           @relation("UserNotifications")
  activityLogs            ActivityLog[]            @relation("UserActivityLogs")
  feedbacks               Feedback[]               @relation("UserFeedbacks")
  collaborationMembers    CollaborationMember[]    @relation("UserCollaborationMembers")
  taskEvidences           TaskEvidence[]           @relation("VerifiedTaskEvidences")
  resolutionVerifications ResolutionVerification[] @relation("UserResolutionVerifications")

  // Government & Verification relations
  officerProfile             GovernmentOfficerProfile? @relation("UserOfficerProfile")
  verificationRecords        VerificationRecord[]      @relation("OfficerVerifications")
  verifiedProblems           Problem[]                 @relation("ProblemVerifiedByUser")
  rejectedProblems           Problem[]                 @relation("ProblemRejectedByUser")
  assignedProblemsAsOfficer  Problem[]                 @relation("ProblemAssignedOfficer")
  resolvedProblems           Problem[]                 @relation("ProblemResolvedByUser")
  departmentAssignmentsGiven DepartmentAssignment[]    @relation("UserDepartmentAssignments")
  officerAssignmentsReceived OfficerAssignment[]       @relation("OfficerAssignedTasks")
  officerAssignmentsGiven    OfficerAssignment[]       @relation("UserOfficerAssignments")
  internalNotes              InternalNote[]            @relation("UserInternalNotes")
  govAuditLogs               GovAuditLog[]             @relation("UserGovAuditLogs")

  @@index([email])
  @@index([role])
  @@map("users")
}

/// Civic problem categories (Roads, Waste, Water, Electricity, etc.)
model ProblemCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Relationships
  problems Problem[] @relation("CategoryProblems")

  @@index([name])
  @@map("problem_categories")
}

/// Core Civic Problems reported by citizens (registered or anonymous)
model Problem {
  id                   String  @id @default(uuid())
  trackingNumber       String? @unique // e.g. JS-2026-A8K7P2
  title                String
  description          String
  categoryId           String
  reportedBy           String? // Nullable for anonymous reports
  isAnonymous          Boolean @default(false)
  cityId               String?
  wardId               String?
  assignedDepartmentId String?
  address              String
  landmark             String?
  city                 String
  state                String
  pincode              String
  latitude             Float?
  longitude            Float?

  severity             ProblemSeverity  @default(MEDIUM)
  priority             ProblemPriority  @default(MEDIUM)
  status               ProblemStatus    @default(SUBMITTED)
  isVerified           Boolean          @default(false)
  governmentPriority   ProblemPriority? @default(NORMAL)
  targetCompletionDate DateTime?
  verifiedAt           DateTime?
  verifiedByUserId     String?
  rejectedAt           DateTime?
  rejectedByUserId     String?
  rejectionReason      String?
  assignedOfficerId    String?
  resolvedAt           DateTime?
  resolvedByUserId     String?
  resolutionNotes      String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  // Foreign Key Relations
  category           ProblemCategory @relation("CategoryProblems", fields: [categoryId], references: [id], onDelete: Restrict)
  reporter           User?           @relation("ReportedByUser", fields: [reportedBy], references: [id], onDelete: SetNull)
  cityEntity         City?           @relation("CityProblems", fields: [cityId], references: [id], onDelete: SetNull)
  ward               Ward?           @relation("WardProblems", fields: [wardId], references: [id], onDelete: SetNull)
  assignedDepartment Department?     @relation("DepartmentProblems", fields: [assignedDepartmentId], references: [id], onDelete: SetNull)
  verifiedByUser     User?           @relation("ProblemVerifiedByUser", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  rejectedByUser     User?           @relation("ProblemRejectedByUser", fields: [rejectedByUserId], references: [id], onDelete: SetNull)
  assignedOfficer    User?           @relation("ProblemAssignedOfficer", fields: [assignedOfficerId], references: [id], onDelete: SetNull)
  resolvedByUser     User?           @relation("ProblemResolvedByUser", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  // Reverse Relations
  anonymousReport       AnonymousReport?         @relation("ProblemAnonymousReport")
  images                ProblemImage[]           @relation("ProblemImages")
  statusHistory         ProblemStatusHistory[]   @relation("ProblemStatusHistory")
  aiAnalyses            AIAnalysis[]             @relation("ProblemAIAnalyses")
  solutionProposals     SolutionProposal[]       @relation("ProblemProposals")
  collaborations        Collaboration[]          @relation("ProblemCollaborations")
  implementationTasks   ImplementationTask[]     @relation("ProblemTasks")
  notifications         Notification[]           @relation("ProblemNotifications")
  feedbacks             Feedback[]               @relation("ProblemFeedbacks")
  verifications         ResolutionVerification[] @relation("ProblemVerifications")
  verificationRecords   VerificationRecord[]     @relation("ProblemVerificationRecords")
  departmentAssignments DepartmentAssignment[]   @relation("ProblemDepartmentAssignments")
  officerAssignments    OfficerAssignment[]      @relation("ProblemOfficerAssignments")
  internalNotes         InternalNote[]           @relation("ProblemInternalNotes")
  govAuditLogs          GovAuditLog[]            @relation("ProblemGovAuditLogs")
  emailNotifications    EmailNotification[]      @relation("ProblemEmailNotifications")

  @@index([city])
  @@index([status])
  @@index([severity])
  @@index([priority])
  @@index([categoryId])
  @@index([reportedBy])
  @@index([assignedDepartmentId])
  @@index([wardId])
  @@index([isAnonymous])
  @@index([verifiedByUserId])
  @@index([assignedOfficerId])
  @@index([createdAt])
  @@map("problems")
}

/// Cryptographically isolated anonymous report record (Zero PII, no User FK)
model AnonymousReport {
  id                String   @id @default(uuid())
  problemId         String   @unique
  publicTrackingId  String   @unique // e.g. TRK-2026-XXXXXX
  trackingTokenHash String // Salted hash of secret token
  trackingTokenSalt String
  ipSubnetHash      String? // Daily-rotated HMAC of subnet for anti-spam
  createdAt         DateTime @default(now())

  // Relation
  problem Problem @relation("ProblemAnonymousReport", fields: [problemId], references: [id], onDelete: Cascade)

  @@index([publicTrackingId])
  @@map("anonymous_reports")
}

/// Evidence and progress photographs attached to a problem
model ProblemImage {
  id           String   @id @default(uuid())
  problemId    String
  imageUrl     String
  thumbnailUrl String?
  caption      String?
  stage        String   @default("INTAKE") // INTAKE, IN_PROGRESS, RESOLUTION
  createdAt    DateTime @default(now())

  // Relation
  problem Problem @relation("ProblemImages", fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
  @@map("problem_images")
}

/// Immutable problem status transition log
model ProblemStatusHistory {
  id         String        @id @default(uuid())
  problemId  String
  fromStatus ProblemStatus
  toStatus   ProblemStatus
  changedBy  String? // User ID if authenticated, or "SYSTEM" / "ANONYMOUS"
  remarks    String?
  createdAt  DateTime      @default(now())

  // Relation
  problem Problem @relation("ProblemStatusHistory", fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
  @@map("problem_status_histories")
}

/// AI analysis records using Grok API by xAI (Stage 7)
model AIAnalysis {
  id                    String    @id @default(uuid())
  problemId             String
  summary               String
  detectedCategory      String
  categoryConfidence    Float?    @default(0.9)
  severity              String
  severityConfidence    Float?    @default(0.85)
  severityReason        String?
  suggestedSolutions    String // JSON encoded array of solution proposals
  recommendedDepartment String
  departmentConfidence  Float?    @default(0.9)
  urgency               String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  possibleDuplicates    String?   @default("[]") // JSON encoded array of duplicates
  confidence            Float     @default(0.9) // Overall composite confidence
  modelName             String    @default("grok-2-latest")
  processingStatus      String    @default("COMPLETED") // PENDING, PROCESSING, COMPLETED, FAILED
  errorMessage          String?
  requiresHumanReview   Boolean   @default(true)
  reviewStatus          String    @default("PENDING") // PENDING, ACCEPTED, EDITED, REJECTED
  reviewedBy            String?
  reviewedAt            DateTime?
  reviewNotes           String?
  promptTokens          Int?      @default(0)
  completionTokens      Int?      @default(0)
  totalTokens           Int?      @default(0)
  durationMs            Int?      @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  // Foreign Key Relation
  problem Problem @relation("ProblemAIAnalyses", fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
  @@index([processingStatus])
  @@index([reviewStatus])
  @@map("ai_analyses")
}

/// Solution proposals by universities, experts, and industries
model SolutionProposal {
  id                String         @id @default(uuid())
  problemId         String
  submittedBy       String
  organizationId    String?
  title             String
  description       String
  proposedApproach  String
  estimatedCost     Float?
  estimatedDuration String?
  status            ProposalStatus @default(PROPOSED)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Foreign Key Relations
  problem      Problem       @relation("ProblemProposals", fields: [problemId], references: [id], onDelete: Cascade)
  submitter    User          @relation("SubmittedProposals", fields: [submittedBy], references: [id], onDelete: Cascade)
  organization Organization? @relation("OrganizationProposals", fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([problemId])
  @@index([submittedBy])
  @@index([organizationId])
  @@index([status])
  @@map("solution_proposals")
}

/// Multi-stakeholder collaborations (Industry CSR, University pilots)
model Collaboration {
  id                String              @id @default(uuid())
  problemId         String
  organization      String
  collaborationType String
  description       String
  status            CollaborationStatus @default(INITIATED)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relationships
  problem Problem               @relation("ProblemCollaborations", fields: [problemId], references: [id], onDelete: Cascade)
  members CollaborationMember[] @relation("CollaborationMembersList")

  @@index([problemId])
  @@index([status])
  @@map("collaborations")
}

/// Junction table for users and organizations participating in a collaboration
model CollaborationMember {
  id              String   @id @default(uuid())
  collaborationId String
  userId          String?
  organizationId  String?
  role            String // RESEARCHER, CONTRACTOR, LEAD, OBSERVER
  joinedAt        DateTime @default(now())

  // Relations
  collaboration Collaboration @relation("CollaborationMembersList", fields: [collaborationId], references: [id], onDelete: Cascade)
  user          User?         @relation("UserCollaborationMembers", fields: [userId], references: [id], onDelete: SetNull)
  organization  Organization? @relation("OrgCollaborationMembers", fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([collaborationId])
  @@index([userId])
  @@map("collaboration_members")
}

/// Ground-level resolution and implementation tasks
model ImplementationTask {
  id                   String     @id @default(uuid())
  problemId            String
  title                String
  description          String
  assignedTo           String?
  assignedDepartmentId String?
  deadline             DateTime?
  progress             Int        @default(0)
  status               TaskStatus @default(PENDING)
  evidence             String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  // Foreign Key Relations
  problem            Problem        @relation("ProblemTasks", fields: [problemId], references: [id], onDelete: Cascade)
  assignee           User?          @relation("AssignedToUser", fields: [assignedTo], references: [id], onDelete: SetNull)
  assignedDepartment Department?    @relation("DepartmentTasks", fields: [assignedDepartmentId], references: [id], onDelete: SetNull)
  evidences          TaskEvidence[] @relation("TaskEvidences")

  @@index([problemId])
  @@index([assignedTo])
  @@index([assignedDepartmentId])
  @@index([status])
  @@map("implementation_tasks")
}

/// Verifiable task completion evidence with before/in-progress/after photos
model TaskEvidence {
  id         String   @id @default(uuid())
  taskId     String
  imageUrl   String
  caption    String?
  stage      String   @default("COMPLETED") // BEFORE, IN_PROGRESS, COMPLETED
  verifiedBy String?
  createdAt  DateTime @default(now())

  // Relations
  task     ImplementationTask @relation("TaskEvidences", fields: [taskId], references: [id], onDelete: Cascade)
  verifier User?              @relation("VerifiedTaskEvidences", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@map("task_evidences")
}

/// User notifications
model Notification {
  id               String   @id @default(uuid())
  recipientId      String
  title            String
  message          String
  type             String
  relatedProblemId String?
  isRead           Boolean  @default(false)
  createdAt        DateTime @default(now())

  // Foreign Key Relations
  recipient      User     @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  relatedProblem Problem? @relation("ProblemNotifications", fields: [relatedProblemId], references: [id], onDelete: SetNull)

  @@index([recipientId])
  @@index([isRead])
  @@map("notifications")
}

/// Audit trail and user activity logging
model ActivityLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  entityType  String
  entityId    String
  description String
  createdAt   DateTime @default(now())

  // Foreign Key Relation
  user User? @relation("UserActivityLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

/// Citizen rating and feedback post-resolution
model Feedback {
  id          String   @id @default(uuid())
  problemId   String
  submittedBy String
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  // Foreign Key Relations
  problem   Problem @relation("ProblemFeedbacks", fields: [problemId], references: [id], onDelete: Cascade)
  submitter User    @relation("UserFeedbacks", fields: [submittedBy], references: [id], onDelete: Cascade)

  @@index([problemId])
  @@index([submittedBy])
  @@map("feedbacks")
}

/// Independent resolution verification by citizen or community
model ResolutionVerification {
  id               String             @id @default(uuid())
  problemId        String
  verifiedBy       String? // User ID or null for anonymous tracking token verification
  status           VerificationStatus @default(CONFIRMED_RESOLVED)
  rating           Int?
  feedbackComments String?
  reopenedReason   String?
  createdAt        DateTime           @default(now())

  // Relations
  problem  Problem @relation("ProblemVerifications", fields: [problemId], references: [id], onDelete: Cascade)
  verifier User?   @relation("UserResolutionVerifications", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@index([problemId])
  @@map("resolution_verifications")
}

/// Government Officer Profile with role hierarchy & department affiliation (Stage 9)
model GovernmentOfficerProfile {
  id             String         @id @default(uuid())
  userId         String         @unique
  governmentRole GovernmentRole @default(GOVERNMENT_OFFICER)
  departmentId   String?
  badgeNumber    String?
  designation    String?
  cityId         String
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relationships
  user       User        @relation("UserOfficerProfile", fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation("DepartmentOfficers", fields: [departmentId], references: [id], onDelete: SetNull)
  city       City        @relation("CityOfficers", fields: [cityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([cityId])
  @@index([departmentId])
  @@map("government_officer_profiles")
}

/// Official verification or rejection record for civic complaints (Stage 10)
model VerificationRecord {
  id              String             @id @default(uuid())
  problemId       String
  officerId       String
  action          VerificationAction
  notes           String
  rejectionReason String?
  createdAt       DateTime           @default(now())

  // Relationships
  problem Problem @relation("ProblemVerificationRecords", fields: [problemId], references: [id], onDelete: Cascade)
  officer User    @relation("OfficerVerifications", fields: [officerId], references: [id], onDelete: Cascade)

  @@index([problemId])
  @@index([officerId])
  @@map("verification_records")
}

/// Department assignment record with priority and target deadline (Stage 10)
model DepartmentAssignment {
  id                   String          @id @default(uuid())
  problemId            String
  departmentId         String
  assignedByUserId     String
  assignmentNotes      String?
  priority             ProblemPriority @default(NORMAL)
  targetCompletionDate DateTime?
  reassignmentReason   String?
  createdAt            DateTime        @default(now())

  // Relationships
  problem        Problem    @relation("ProblemDepartmentAssignments", fields: [problemId], references: [id], onDelete: Cascade)
  department     Department @relation("DepartmentAssignedRecords", fields: [departmentId], references: [id], onDelete: Cascade)
  assignedByUser User       @relation("UserDepartmentAssignments", fields: [assignedByUserId], references: [id], onDelete: Cascade)

  @@index([problemId])
  @@index([departmentId])
  @@index([assignedByUserId])
  @@map("department_assignments")
}

/// Field officer direct assignment with deadlines and tracking (Stage 10)
model OfficerAssignment {
  id               String                  @id @default(uuid())
  problemId        String
  officerUserId    String
  assignedByUserId String
  assignmentNotes  String?
  deadline         DateTime?
  status           OfficerAssignmentStatus @default(ASSIGNED)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  // Relationships
  problem        Problem @relation("ProblemOfficerAssignments", fields: [problemId], references: [id], onDelete: Cascade)
  officerUser    User    @relation("OfficerAssignedTasks", fields: [officerUserId], references: [id], onDelete: Cascade)
  assignedByUser User    @relation("UserOfficerAssignments", fields: [assignedByUserId], references: [id], onDelete: Cascade)

  @@index([problemId])
  @@index([officerUserId])
  @@index([assignedByUserId])
  @@map("officer_assignments")
}

/// Internal notes between municipal officers and administrators
model InternalNote {
  id        String   @id @default(uuid())
  problemId String
  authorId  String
  noteText  String
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relationships
  problem Problem @relation("ProblemInternalNotes", fields: [problemId], references: [id], onDelete: Cascade)
  author  User    @relation("UserInternalNotes", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([problemId])
  @@index([authorId])
  @@map("internal_notes")
}

/// Immutable government action audit trail
model GovAuditLog {
  id        String   @id @default(uuid())
  actorId   String
  action    String
  problemId String?
  metadata  Json?
  createdAt DateTime @default(now())

  // Relationships
  actor   User     @relation("UserGovAuditLogs", fields: [actorId], references: [id], onDelete: Cascade)
  problem Problem? @relation("ProblemGovAuditLogs", fields: [problemId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([problemId])
  @@index([action])
  @@map("gov_audit_logs")
}

/// Official confirmation and status update email notifications (Section 6 & 7)
model EmailNotification {
  id               String    @id @default(uuid())
  problemId        String?
  recipientEmail   String
  notificationType String    // e.g. COMPLAINT_CONFIRMATION, STATUS_UPDATE
  deliveryStatus   String    // SENT, FAILED, PENDING
  sentAt           DateTime?
  errorDetails     String?
  metadata         Json?
  createdAt        DateTime  @default(now())

  // Relationships
  problem Problem? @relation("ProblemEmailNotifications", fields: [problemId], references: [id], onDelete: SetNull)

  @@index([problemId])
  @@index([recipientEmail])
  @@index([deliveryStatus])
  @@map("email_notifications")
}
