# ──────────────────────────────────────────────
# JanSamadhan Server – Environment Configuration
# Copy this file to .env and supply actual values
# NEVER commit the actual .env file
# ──────────────────────────────────────────────

# Server Runtime
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jansamadhan?schema=public"

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Client Application URL (for CORS & Cookie Origin)
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Grok AI API by xAI (Preparation for Stage 7)
XAI_API_KEY=
