# ──────────────────────────────────────────────
# JanSamadhan Server – Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit the actual .env file
# ──────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000

# Database (MongoDB) – Stage 2+
# MONGO_URI=mongodb://localhost:27017/jansamadhan
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/jansamadhan

# JSON Web Token – Stage 2+
# JWT_SECRET=your_super_secret_jwt_key_here
# JWT_EXPIRES_IN=7d

# Grok AI API – Stage 3+
# GROK_API_KEY=your_grok_api_key_here
# GROK_API_BASE_URL=https://api.x.ai/v1

# CORS – comma-separated allowed origins
CORS_ORIGIN=http://localhost:5173
