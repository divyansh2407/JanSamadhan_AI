# ──────────────────────────────────────────────
# JanSamadhan Server – Environment Configuration
# Copy this file to .env and supply actual values
# NEVER commit the actual .env file
# ──────────────────────────────────────────────

# Server Runtime
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/jansamadhan?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Client Application URL (for CORS & Cookie Origin)
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
