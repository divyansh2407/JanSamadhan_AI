# ──────────────────────────────────────────────
# JanSamadhan Server – Environment Configuration
# Copy this file to .env and supply actual values
# NEVER commit the actual .env file
# ──────────────────────────────────────────────

# Server Runtime
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jansamadhan?schema=public"

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Client Application URL (for CORS & Cookie Origin)
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Grok AI API by xAI (Stage 7)
XAI_API_KEY=
XAI_MODEL=grok-2-latest
XAI_BASE_URL=https://api.x.ai/v1

# Email Service Provider (Resend or SMTP - Section 6)
# Option A: Resend API (Recommended - https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=JanSamadhan <noreply@jansamadhan.gov.in>

# Option B: Standard SMTP Provider (Optional fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

